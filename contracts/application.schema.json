{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JustShinobi/platform-workflows/contracts/application.schema.json",
  "title": "Homelab application delivery descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "components", "gitops"],
  "properties": {
    "schemaVersion": {"const": 1},
    "application": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "context", "dockerfile", "workload", "container", "rolloutProfile"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "image": {"type": "string", "pattern": "^registry\\.lan\\.kyo\\.ninja/[a-z0-9._/-]+$"},
          "context": {"$ref": "#/$defs/relativePath"},
          "dockerfile": {"$ref": "#/$defs/relativePath"},
          "workload": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "container": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "target": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["linux/amd64", "linux/arm64"]}
          },
          "rolloutProfile": {"enum": ["deployment", "bluegreen", "canary"]}
        }
      }
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "baseBranch", "stagingBranch", "productionBranch",
        "stagingPath", "productionPath", "stagingApplication", "productionApplication"
      ],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "baseBranch": {"$ref": "#/$defs/gitRef"},
        "stagingBranch": {"$ref": "#/$defs/gitRef"},
        "productionBranch": {"$ref": "#/$defs/gitRef"},
        "stagingPath": {"$ref": "#/$defs/relativePath"},
        "productionPath": {"$ref": "#/$defs/relativePath"},
        "stagingApplication": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "productionApplication": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"}
      }
    },
    "t14": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "blockReason"],
          "properties": {
            "enabled": {"const": false},
            "blockReason": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled", "builderKeyId", "builderTargets", "gitopsPath",
            "gitopsApplication", "imageComponent", "sharedComponents", "baselineSourceSha",
            "baselineRepository", "baselineRunId", "baselineArtifactName"
          ],
          "properties": {
            "enabled": {"const": true},
            "builderKeyId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,120}$"},
            "builderTargets": {
              "type": "array",
              "const": [
                "baseline", "proposed", "proposed-without-relations",
                "proposed-without-t06_readers", "proposed-without-t07_probes",
                "proposed-without-t09_planning"
              ]
            },
            "gitopsPath": {"$ref": "#/$defs/relativePath"},
            "gitopsApplication": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
            "imageComponent": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
            "sharedComponents": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
            },
            "baselineSourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "baselineRepository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "baselineRunId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
            "baselineArtifactName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "gitRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
