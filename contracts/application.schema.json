{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JustShinobi/platform-workflows/contracts/application.schema.json",
  "title": "Homelab application delivery descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "components", "gitops"],
  "properties": {
    "schemaVersion": {"const": 1},
    "application": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "context", "dockerfile", "workload", "container", "rolloutProfile"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "image": {"type": "string", "pattern": "^registry\\.lan\\.kyo\\.ninja/[a-z0-9._/-]+$"},
          "context": {"$ref": "#/$defs/relativePath"},
          "dockerfile": {"$ref": "#/$defs/relativePath"},
          "workload": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "container": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "target": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["linux/amd64", "linux/arm64"]}
          },
          "rolloutProfile": {"enum": ["deployment", "bluegreen", "canary"]}
        }
      }
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "baseBranch", "stagingBranch", "productionBranch",
        "stagingPath", "productionPath", "stagingApplication", "productionApplication"
      ],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "baseBranch": {"$ref": "#/$defs/gitRef"},
        "stagingBranch": {"$ref": "#/$defs/gitRef"},
        "productionBranch": {"$ref": "#/$defs/gitRef"},
        "stagingPath": {"$ref": "#/$defs/relativePath"},
        "productionPath": {"$ref": "#/$defs/relativePath"},
        "stagingApplication": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "productionApplication": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "gitRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
